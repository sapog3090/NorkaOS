#!/bin/sh
# Приветствие NorkaOS: лого слева, сведения о компьютере справа (fastfetch с нашим конфигом).
# В текстовой консоли нет truecolor, а в узком окне картинка поедет, там молчим
[ "$TERM" = linux ] && exit 0
# Выключается в Норка Центре
[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/norka/no-terminal-hello" ] && exit 0
[ "$(tput cols 2>/dev/null || echo 80)" -ge 70 ] || exit 0
command -v fastfetch >/dev/null && exec fastfetch
