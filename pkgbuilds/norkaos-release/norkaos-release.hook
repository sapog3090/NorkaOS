# filesystem при обновлении возвращает os-release от Arch, поэтому кладём свой обратно
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/os-release
Target = usr/share/norkaos/os-release

[Action]
Description = Записываю os-release NorkaOS...
When = PostTransaction
Exec = /usr/bin/install -m644 /usr/share/norkaos/os-release /usr/lib/os-release
