{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Norka Center",
  "version": "1.0.0",
  "identifier": "org.norkaos.center",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Norka Center",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
