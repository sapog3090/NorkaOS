pkgname=norkaos-tweaks
pkgver=1
pkgrel=1
pkgdesc='Настройки NorkaOS: sysctl и zram'
arch=('any')
url='https://github.com/sapog3090/NorkaOS'
license=('GPL-3.0-only')
depends=('zram-generator')
source=('90-norkaos.conf' 'zram-generator.conf')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 90-norkaos.conf "$pkgdir/usr/lib/sysctl.d/90-norkaos.conf"
  install -Dm644 zram-generator.conf "$pkgdir/usr/lib/systemd/zram-generator.conf"
}
