pkgname=norkaos-shell
pkgver=5
pkgrel=1
pkgdesc='Оболочка NorkaOS: Норка на рабочем столе и меню'
arch=('any')
url='https://github.com/sapog3090/NorkaOS'
license=('GPL-3.0-only')
depends=('plasma-desktop' 'plasma-workspace' 'libksysguard' 'noto-fonts-emoji' 'qt6-multimedia-ffmpeg')
makedepends=('gettext')

# Картинки берутся из папки art, её кладёт сюда build-repo.sh
package() {
  cd "$startdir"
  local dir="$pkgdir/usr/share/plasma/plasmoids"
  install -d "$dir"
  cp -r plasmoids/. "$dir/"
  install -Dm644 art/mascot/norka-shy.png "$dir/org.norkaos.mascot/contents/images/shy.png"
  install -Dm644 art/mascot/norka-face.png "$dir/org.norkaos.menu/contents/images/face.png"
  install -Dm644 art/mascot/norka-peek.png "$dir/org.norkaos.menu/contents/images/peek.png"
  chmod -R u=rwX,go=rX "$dir"
  # Переводы: Plasma ищет каталог plasma_applet_<id> в системных локалях
  for po in po/*.po; do
    local name lang
    name="$(basename "$po" .po)"; lang="${name##*.}"; name="${name%.*}"
    install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
    msgfmt -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/plasma_applet_$name.mo" "$po"
  done
}
