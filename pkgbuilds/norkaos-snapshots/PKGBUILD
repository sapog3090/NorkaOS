pkgname=norkaos-snapshots
pkgver=1
pkgrel=1
pkgdesc='Снимки NorkaOS перед обновлениями и откат из меню загрузки Limine'
arch=('any')
url='https://github.com/sapog3090/NorkaOS'
license=('GPL-3.0-only')
depends=('snapper' 'snap-pac' 'btrfs-progs' 'mkinitcpio')
source=('norka-snapshots' 'norka-rollback' '06-norka-snapshots-save.hook' 'zz-norka-snapshots-sync.hook'
        'initcpio-install' 'initcpio-hook' 'root-config')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 norka-snapshots "$pkgdir/usr/bin/norka-snapshots"
  install -Dm755 norka-rollback "$pkgdir/usr/bin/norka-rollback"
  install -Dm644 06-norka-snapshots-save.hook "$pkgdir/usr/share/libalpm/hooks/06-norka-snapshots-save.hook"
  install -Dm644 zz-norka-snapshots-sync.hook "$pkgdir/usr/share/libalpm/hooks/zz-norka-snapshots-sync.hook"
  install -Dm644 initcpio-install "$pkgdir/usr/lib/initcpio/install/norka-overlay"
  install -Dm644 initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/norka-overlay"
  install -Dm644 root-config "$pkgdir/usr/share/norkaos/snapper-root"
}
