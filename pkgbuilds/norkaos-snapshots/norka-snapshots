#!/usr/bin/env bash
# Снимки системы в меню загрузки Limine.
#   norka-snapshots save   перед обновлением: копирует текущее ядро к последнему снимку snapper
#   norka-snapshots sync   после обновления: пишет пункты снимков в limine.conf и чистит старые копии
# Ядро и initramfs лежат на FAT-разделе /boot, в снимок Btrfs они не попадают,
# поэтому к каждому снимку храним свою копию: со старым ядром снимок загрузится наверняка
set -euo pipefail

boot=/boot
store=$boot/snapshots
conf=$boot/limine/limine.conf
keep=5
kernel=linux-cachyos
begin='# norka-snapshots begin'
end='# norka-snapshots end'

[[ -f "$conf" ]] || exit 0

# Снимки «до обновления» от snap-pac: номер|дата|описание, самые свежие в конце
pre_snapshots() {
  snapper --no-dbus -c root --csvout list --columns number,type,date,description 2>/dev/null |
    awk -F, 'NR > 1 && $2 == "pre" { print $1 "|" $3 "|" $4 }' | tail -n "$keep"
}

save() {
  local last
  last="$(snapper --no-dbus -c root --csvout list --columns number,type 2>/dev/null | awk -F, '$2 == "pre" { n = $1 } END { print n }')"
  [[ -n "$last" && ! -d "$store/$last" ]] || return 0
  mkdir -p "$store/$last"
  cp "$boot/vmlinuz-$kernel" "$boot/initramfs-$kernel.img" "$store/$last/"
}

sync_entries() {
  local main_cmdline numbers entries=""
  main_cmdline="$(awk '/^\/NorkaOS$/ { f = 1 } f && /cmdline:/ { sub(/^ *cmdline: */, ""); print; exit }' "$conf")"
  [[ -n "$main_cmdline" ]] || return 0
  numbers=""
  while IFS='|' read -r number date description; do
    [[ -n "$number" && -f "$store/$number/vmlinuz-$kernel" ]] || continue
    numbers+=" $number"
    local cmdline="${main_cmdline/subvol=@/subvol=@snapshots/$number/snapshot}"
    entries="//#$number ${date%:*} ${description:-update}
    protocol: linux
    path: boot():/snapshots/$number/vmlinuz-$kernel
    cmdline: ${cmdline/ rw/ ro}
    module_path: boot():/snapshots/$number/initramfs-$kernel.img
$entries"
  done < <(pre_snapshots)

  # Копии ядра для удалённых снимков больше не нужны
  for dir in "$store"/*/; do
    [[ -d "$dir" ]] || continue
    [[ " $numbers " == *" $(basename "$dir") "* ]] || rm -rf "$dir"
  done

  local tmp
  tmp="$(mktemp)"
  awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$conf" > "$tmp"
  if [[ -n "$entries" ]]; then
    printf '\n%s\n/Snapshots\n%s%s\n' "$begin" "$entries" "$end" >> "$tmp"
  fi
  cat "$tmp" > "$conf"
  rm -f "$tmp"
}

case "${1:-}" in
  save) save ;;
  sync) sync_entries ;;
  *) echo "usage: norka-snapshots save|sync" >&2; exit 1 ;;
esac
